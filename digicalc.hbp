# DigiCalc - spreadsheet in character mode (Harbour-CUI)
#   Windows: build.bat     Linux: ./build.sh
#   or: hbmk2 digicalc.hbp   (Harbour 3.2.1, the Harbour-CUI library built)
# Harbour-CUI in ../Harbour-CUI, the XLSX class in ../xlsx (next to this folder).

-w3 -es2
-odigicalc
{win}digicalc.rc

../Harbour-CUI/hbtui.hbc
hbct.hbc
hbmzip.hbc
hbziparc.hbc

digicalc.prg
dcgrid.prg
dcsheet.prg
dcformula.prg
dcfunc.prg
dcfile.prg
dcmenu.prg

# the XLSX class (github.com/digikv/xlsx) in ../xlsx; without it no .xlsx (only .csv)
{hb_ispath='../xlsx/XLSXClass.prg'}../xlsx/XLSXClass.prg
{!hb_ispath='../xlsx/XLSXClass.prg'}-prgflag=-DDC_NO_XLSX

{unix}-lX11
